# =========================
# WordPress Project .gitignore
# =========================

# Ignore sensitive files
wp-config.php
wp-config-sample.php
.env
.env.local
.env.*.local

# Ignore WordPress core (optional, if you want to track only custom code)
wp-admin/
wp-includes/

# Ignore user-generated content
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/backups/
wp-content/advanced-cache.php
wp-content/ai1wm-backups/

# Ignore plugins and themes you don't want tracked
# Uncomment and customize if needed
# wp-content/plugins/
# wp-content/themes/

# Ignore system files and OS junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Ignore logs and debug files
*.log
*.sql
*.sqlite
*.zip
*.tar.gz

# Ignore IDE/editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore Node and Composer dependencies
node_modules/
vendor/

# Ignore Git-related files from submodules or legacy
.gitignore~
.gitattributes~
